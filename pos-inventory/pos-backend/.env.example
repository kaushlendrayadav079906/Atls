SAP_COMPANY_DB=<YOUR_COMPANY_DB>
SAP_USERNAME=<YOUR_SAP_USERNAME>
SAP_PASSWORD=<YOUR_SAP_PASSWORD>
SAP_SSL_VERIFY=False


# SAP B1 Default Settings
SAP_DEFAULT_WAREHOUSE=SH
SAP_DEFAULT_PRICE_LIST=1
SAP_DEFAULT_CARD_TYPE=C

# Rate Limiting (requests / minute)
RATE_LIMIT_GENERAL=120/minute
RATE_LIMIT_SALES=30/minute

# Circuit Breaker
SAP_CB_THRESHOLD=5
SAP_CB_RECOVERY_TIMEOUT=30.0

# Cache Settings
CACHE_PRODUCTS_TTL=900
CACHE_PRICE_LISTS_TTL=3600
CACHE_CUSTOMERS_TTL=1800

# Sync Job Settings
SYNC_PRODUCTS_INTERVAL=900
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=60

# Timezone
TIMEZONE=Asia/Kolkata

# AI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
