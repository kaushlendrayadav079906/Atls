# Application Settings
APP_NAME="POS Backend API"
APP_VERSION="1.0.0"
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=3000
RELOAD=True

# CORS Settings (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# For PostgreSQL (Production)
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/pos_db
# For SQLite (Development)
# DATABASE_URL=sqlite:///./pos.db

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-in-production
REGISTER_MASTER_PASSWORD=change-this-master-password
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SAP Business One Service Layer Configuration
SAP_SERVICE_LAYER_URL=https://sapserver:50000/b1s/v1
SAP_COMPANY_DB=SBODEMOUS
SAP_USERNAME=manager
SAP_PASSWORD=your-sap-password
SAP_SSL_VERIFY=False

# SAP B1 Default Settings
SAP_DEFAULT_WAREHOUSE=01
SAP_DEFAULT_PRICE_LIST=1
SAP_DEFAULT_CARD_TYPE=C


# Public base URL (used when building absolute URLs in background tasks)
# Example: PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=

# Rate Limiting (requests / minute)
RATE_LIMIT_GENERAL=120/minute
RATE_LIMIT_SALES=30/minute

# Image endpoint (public) rate limit
RATE_LIMIT_IMAGES=60/minute

# Circuit Breaker
SAP_CB_THRESHOLD=5
SAP_CB_RECOVERY_TIMEOUT=30.0

# Cache Settings
CACHE_PRODUCTS_TTL=900
CACHE_PRICE_LISTS_TTL=3600
CACHE_CUSTOMERS_TTL=1800

# Product image caching (seconds)
CACHE_PRODUCT_IMAGES_TTL=3600

# Picture fallback (for SAP Items.Picture when AttachmentEntry is null)
# If your SAP environment stores item pictures on a shared folder accessible
# by the backend, set SAP_PICTURE_BASE_PATH to that folder.
SAP_PICTURE_BASE_PATH=
# Or, if pictures are hosted over HTTP, set a base URL and the backend will
# 307-redirect the browser.
SAP_PICTURE_BASE_URL=

# Sync Job Settings
SYNC_PRODUCTS_INTERVAL=900
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=60

# Timezone
TIMEZONE=Asia/Kolkata
